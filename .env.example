# Copy to .env and fill in. .env is git-ignored; never commit it.

# Postgres (used by docker compose and DATABASE_URL)
POSTGRES_PASSWORD=signals
DATABASE_URL=postgresql+psycopg://signals:signals@127.0.0.1:5432/signals

# SEC requires a contact in the User-Agent: "Full Name email@domain"
SEC_USER_AGENT=
SEC_RATE_LIMIT=8

# Where raw filings are archived (never deleted)
RAW_ARCHIVE_DIR=data/raw

# History
BACKFILL_START=2016-01-01
FORM144_START=2023-04-13
STAKES_START=2024-12-18

# Prices: alpaca (needs keys below) or yfinance
PRICE_PRIMARY=alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=sip
ALPACA_DATA_URL=https://data.alpaca.markets

# Optional: raises OpenFIGI rate limits for CUSIP mapping
OPENFIGI_API_KEY=

# Tracked funds
TRACKED_FUNDS_TOP_N=500
TRACKED_FUNDS_MAX_POSITIONS=300

LOG_JSON=true
